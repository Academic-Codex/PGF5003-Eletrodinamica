Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`B$$ = 10000, $CellContext`m$$ = 
    1.*^-20, $CellContext`p$$ = {0, 0}, Typeset`show$$ = True, 
