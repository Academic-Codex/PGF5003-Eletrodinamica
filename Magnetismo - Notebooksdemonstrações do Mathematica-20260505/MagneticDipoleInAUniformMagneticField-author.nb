    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`m$$], 1.*^-20, "magnetic moment (erg/gauss)"}, 
      Rational[1, 100000000000000000000], 
