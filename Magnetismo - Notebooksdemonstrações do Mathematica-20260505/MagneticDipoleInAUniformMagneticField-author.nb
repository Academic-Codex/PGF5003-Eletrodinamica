Cell[CellGroupData[{

Cell["", "ManipulateCaptionSection"],

Cell[TextData[{
 "This Demonstration allows you to visualize the distortion of a uniform \
magnetic field due to the presence of a point magnetic dipole. It is \
interesting that in this configuration, there exists a sphere through which \
no magnetic flux passes. This occurs at the characteristic radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", "m"}], "B"], ")"}], 
     RowBox[{"1", "/", "3"}]]}], TraditionalForm]], "InlineMath"],
 " where ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineMath"],
 " is the magnetic moment of the dipole (in erg/gauss) and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "InlineMath"],
 " is the magnitude of the uniform magnetic field (in gauss). This result can \
be derived by setting the sum of the radial contributions from the dipole and \
external field equal to zero, then solving for ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]], "InlineMath"],
 "."
}], "ManipulateCaption",
 CellChangeTimes->{
  3.35696210375764*^9, {3.4530989103465977`*^9, 3.453098997092346*^9}, {
   3.4531238526791253`*^9, 3.453123883295186*^9}, {3.4531321429061623`*^9, 
   3.4531322703444777`*^9}, {3.4531473552341433`*^9, 3.453147372031671*^9}, {
   3.4531474514399757`*^9, 3.453147476673092*^9}, {3.4531475122027273`*^9, 
   3.453147546241523*^9}, {3.4531475877463818`*^9, 3.4531476534753036`*^9}, {
   3.453157826690887*^9, 3.453157899771399*^9}, {3.453158030512751*^9, 
   3.453158064776277*^9}, {3.4531581003728867`*^9, 3.453158248527869*^9}, 
   3.453158462420361*^9},
 CellID->97600649],

Cell[TextData[{
 "You can change the magnetic field by dragging the locator around the plot \
area. You can also change the magnitudes of ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]], "InlineMath"],
 " and ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]], "InlineMath"],
 " with the sliders."
}], "ManipulateCaption",
 CellChangeTimes->{
  3.35696210375764*^9, {3.4530989103465977`*^9, 3.453098997084083*^9}, {
   3.4531238702398815`*^9, 3.453123883309188*^9}, {3.4531322967196465`*^9, 
   3.453132325547956*^9}, {3.453157958948584*^9, 3.453157964364126*^9}, {
   3.453157996078012*^9, 3.453158005350045*^9}},
 CellID->1844085082]
}, Open  ]],

