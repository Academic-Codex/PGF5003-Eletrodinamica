Notebook[{

Cell[CellGroupData[{
Cell["Magnetic Dipole in a Uniform Magnetic Field ", "DemoTitle",
 CellChangeTimes->{
  3.35696210375764*^9, {3.4531238999458513`*^9, 3.4531239191537724`*^9}, 
   3.453132075921358*^9, {3.453147273506116*^9, 3.453147290878889*^9}}],

Cell["", "InitializationSection"],

