       Hold[$CellContext`B$$], 10000, "uniform B field (gauss)"}, 10000, 
      100000}, {{
       Hold[$CellContext`p$$], {0, 0}}, Automatic}}, Typeset`size$$ = {
    675., {295., 305.}}, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = True, $CellContext`m$38627$$ = 
    0, $CellContext`B$38628$$ = 0}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`B$$ = 10000, $CellContext`m$$ = 
        1.*^-20, $CellContext`p$$ = {0, 0}}, "ControllerVariables" :> {
        Hold[$CellContext`m$$, $CellContext`m$38627$$, 0], 
        Hold[$CellContext`B$$, $CellContext`B$38628$$, 0]}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`radius$, $CellContext`x$, $CellContext`y$, \
$CellContext`Bx$, $CellContext`By$, $CellContext`bound$ = 
         4 10^(-8)}, $CellContext`radius$ = (
           2 ($CellContext`m$$/$CellContext`B$$))^(1/3); $CellContext`Bx$[
           Pattern[$CellContext`x$, 
            Blank[]], 
           Pattern[$CellContext`y$, 
            Blank[]]] := ((
            3 $CellContext`m$$) $CellContext`x$) \
($CellContext`y$/($CellContext`x$^2 + $CellContext`y$^2)^(5/
            2)); $CellContext`By$[
           Pattern[$CellContext`x$, 
            Blank[]], 
           Pattern[$CellContext`y$, 
            Blank[]]] := $CellContext`m$$ (
            3 ($CellContext`y$^2/($CellContext`x$^2 + $CellContext`y$^2)^(5/
               2)) - 1/($CellContext`x$^2 + $CellContext`y$^2)^(3/
             2)) - $CellContext`B$$; Show[
          VectorPlot[
           Normalize[{
             Evaluate[
              $CellContext`Bx$[$CellContext`x$, $CellContext`y$]], 
             Evaluate[
              $CellContext`By$[$CellContext`x$, $CellContext`y$]]}], \
{$CellContext`x$, -$CellContext`bound$, $CellContext`bound$}, \
{$CellContext`y$, -$CellContext`bound$, $CellContext`bound$}, VectorScale -> 
           0.05, VectorColorFunction -> "Rainbow"], 
          
          ParametricPlot[{$CellContext`radius$ 
            Cos[$CellContext`t], $CellContext`radius$ 
            Sin[$CellContext`t]}, {$CellContext`t, 0, 2 Pi}, 
           PlotStyle -> {Thick, Black}], 
          PlotRange -> {{-$CellContext`bound$, $CellContext`bound$}, \
{-$CellContext`bound$, $CellContext`bound$}}, PlotLabel -> 
          If[$CellContext`p$$ == {0, 0}, 
            
            Row[{"The magnetic field at ", $CellContext`p$$, 
              " is infinite."}], 
            Row[{"The magnetic field at ", $CellContext`p$$, " is ", {
               $CellContext`Bx$[
                Part[$CellContext`p$$, 1], 
                Part[$CellContext`p$$, 2]], 
