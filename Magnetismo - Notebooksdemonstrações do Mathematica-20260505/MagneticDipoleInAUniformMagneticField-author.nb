Cell["", "ManipulateSection"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"radius", ",", "x", ",", "y", ",", "Bx", ",", "By", ",", 
       RowBox[{"bound", "=", 
        RowBox[{"4", "*", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"radius", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"m", "/", "B"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "3"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Bx", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{"3", " ", "m", "*", "x", "*", 
        RowBox[{"y", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "^", "2"}], "+", 
            RowBox[{"y", "^", "2"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"5", "/", "2"}], ")"}]}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"By", "[", 
        RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"m", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", 
            RowBox[{
             RowBox[{"y", "^", "2"}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "^", "2"}], "+", 
                RowBox[{"y", "^", "2"}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"5", "/", "2"}], ")"}]}]}]}], "-", 
           RowBox[{"1", "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "^", "2"}], "+", 
               RowBox[{"y", "^", "2"}]}], ")"}], "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "2"}], ")"}]}]}]}], ")"}]}], "-", "B"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"VectorPlot", "[", 
         RowBox[{
          RowBox[{"Normalize", "@", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Evaluate", "@", 
              RowBox[{"Bx", "[", 
               RowBox[{"x", ",", "y"}], "]"}]}], ",", 
             RowBox[{"Evaluate", "@", 
              RowBox[{"By", "[", 
               RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "bound"}], ",", "bound"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "bound"}], ",", "bound"}], "}"}], ",", 
          RowBox[{"VectorScale", "\[Rule]", "0.05"}], ",", 
          RowBox[{"VectorColorFunction", "\[Rule]", "\"\<Rainbow\>\""}]}], 
         "]"}], ",", 
        RowBox[{"ParametricPlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"radius", "*", 
             RowBox[{"Cos", "[", "t", "]"}]}], ",", 
            RowBox[{"radius", "*", 
             RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Thick", ",", "Black"}], "}"}]}]}], "]"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "bound"}], ",", "bound"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "bound"}], ",", "bound"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"p", "\[Equal]", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
             "\"\<The magnetic field at \>\"", ",", "p", ",", 
              "\"\< is infinite.\>\""}], "}"}], "]"}], ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
             "\"\<The magnetic field at \>\"", ",", "p", ",", "\"\< is \>\"", 
              ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Bx", "[", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"p", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
                RowBox[{"By", "[", 
                 RowBox[{
                  RowBox[{"p", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"p", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
              "\"\<.\>\""}], "}"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"450", ",", "400"}], "}"}]}], ",", 
        RowBox[{"ImagePadding", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"55", ",", "20"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"25", ",", "10"}], "}"}]}], "}"}]}]}], "]"}]}]}], "]"}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", 
       RowBox[{
        RowBox[{"N", "@", "10"}], "^", 
        RowBox[{"-", "20"}]}], ",", "\"\<magnetic moment (erg/gauss)\>\""}], 
      "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "20"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "19"}]}], ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"B", ",", "10000", ",", "\"\<uniform B field (gauss)\>\""}], 
      "}"}], ",", "10000", ",", "100000", ",", 
     RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}], ",", "Locator"}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"AutorunSequencing", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"TrackedSymbols", "\[Rule]", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{
  3.35696210375764*^9, 3.453095935742181*^9, 3.4530965832092133`*^9, {
   3.453123752556114*^9, 3.453123838470704*^9}, {3.453124033758231*^9, 
