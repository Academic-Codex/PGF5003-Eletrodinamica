Cell[CellGroupData[{

Cell["", "ManipulateCaptionSection"],

Cell[TextData[{
 "A electrical current ",
 Cell[BoxData[
  FormBox["I", TraditionalForm]], "InlineMath"],
 " moving around a circular loop of radius ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "InlineMath"],
 ", shown in yellow from a lateral point of view, produces a magnetic field, \
with lines of force shown as blue loops. For clarity, only lines of force in \
the vertical plane bisecting the ring (",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]], "InlineMath"],
 ") are shown."
}], "ManipulateCaption",
 CellChangeTimes->{
  3.35696210375764*^9, {3.473282527312879*^9, 3.473282683939802*^9}, {
   3.4732827309100924`*^9, 3.4732829465276537`*^9}, {3.473283134353417*^9, 
   3.473283137520609*^9}, {3.4732831719464293`*^9, 3.473283223236512*^9}, {
   3.473283257149941*^9, 3.473283362858482*^9}, 3.473283405428837*^9, {
   3.473283449086834*^9, 3.473283463803073*^9}, {3.4732835434575977`*^9, 
   3.473283601077381*^9}, {3.4732836330419903`*^9, 3.473283691929368*^9}, {
   3.473283745262185*^9, 3.473283951787839*^9}, {3.473284019360796*^9, 
   3.473284130339429*^9}, {3.4732842283308563`*^9, 3.473284229777863*^9}, {
   3.473284280901081*^9, 3.4732843578872433`*^9}, {3.4732844373315697`*^9, 
   3.473284473315894*^9}, {3.4732845230780773`*^9, 3.4732845282699347`*^9}, {
   3.4732845650175667`*^9, 3.473284579520184*^9}, {3.473284621510919*^9, 
   3.473284671790493*^9}, {3.473284902353133*^9, 3.473285001722598*^9}, {
   3.4732870129653387`*^9, 3.473287013497169*^9}, {3.4736316455598245`*^9, 
   3.4736316613254495`*^9}, {3.4736317048254495`*^9, 
   3.4736317127316995`*^9}, {3.4737074254305887`*^9, 
   3.4737074260970087`*^9}, {3.47415674368743*^9, 3.474156746052661*^9}, 
   3.476717921458014*^9}],

Cell[TextData[{
 "The strength of the magnetic field is indicated by the density of the lines \
of force. The magnitude is expressed in units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Mu]", "0"], "/", "4"}], "\[Pi]"}], TraditionalForm]], 
  "InlineMath"],
 ". The field is cylindrically symmetrical about the axis of the ring. By a \
right-hand rule, a counterclockwise current produces magnetic lines of force \
that point upward inside the ring, downward outside the ring. At distances ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[GreaterGreater]", "a"}], TraditionalForm]], "InlineMath"],
 ", the ring behaves like a magnetic dipole ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["m",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{"\[Pi]", " ", 
     SuperscriptBox["a", "2"], 
     StyleBox["I",
      FontWeight->"Bold",
      FontSlant->"Plain"]}]}], TraditionalForm]], "InlineMath"],
 ", with vector potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[Mu]", "0"], 
      RowBox[{"4", "\[Pi]"}]], 
     FractionBox[
      RowBox[{
       StyleBox["m",
        FontWeight->"Bold",
        FontSlant->"Plain"], " ", "\[Cross]", " ", 
       StyleBox["r",
        FontWeight->"Bold",
        FontSlant->"Plain"]}], 
      SuperscriptBox["r", "3"]]}]}], TraditionalForm]], "InlineMath"],
 ". As ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Rule]", "0"}], TraditionalForm]], "InlineMath"],
 " (with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], "I"}], TraditionalForm]], "InlineMath"],
 " constant), this approaches the field of a point magnetic dipole."
}], "ManipulateCaption",
 CellChangeTimes->{
  3.35696210375764*^9, {3.473282527312879*^9, 3.473282683939802*^9}, {
   3.4732827309100924`*^9, 3.4732829465276537`*^9}, {3.473283134353417*^9, 
   3.473283137520609*^9}, {3.4732831719464293`*^9, 3.473283223236512*^9}, {
   3.473283257149941*^9, 3.473283362858482*^9}, 3.473283405428837*^9, {
   3.473283449086834*^9, 3.473283463803073*^9}, {3.4732835434575977`*^9, 
   3.473283601077381*^9}, {3.4732836330419903`*^9, 3.473283691929368*^9}, {
   3.473283745262185*^9, 3.473283951787839*^9}, {3.473284019360796*^9, 
   3.473284130339429*^9}, {3.4732842283308563`*^9, 3.473284229777863*^9}, {
   3.473284280901081*^9, 3.4732843578872433`*^9}, {3.4732844373315697`*^9, 
   3.473284473315894*^9}, {3.4732845230780773`*^9, 3.4732845282699347`*^9}, {
   3.4732845650175667`*^9, 3.473284579520184*^9}, {3.473284621510919*^9, 
   3.473284671790493*^9}, {3.473284902353133*^9, 3.473285001722598*^9}, {
   3.4732870129653387`*^9, 3.473287013497169*^9}, {3.4736316455598245`*^9, 
   3.4736316613254495`*^9}, {3.4736317048254495`*^9, 
   3.4736317127316995`*^9}, {3.4766219185657873`*^9, 3.476621951402999*^9}, {
   3.476622493112239*^9, 3.476622605006702*^9}, {3.4994419481215*^9, 
   3.499441950855875*^9}, {3.49944294184025*^9, 3.499442972559*^9}, {
   3.49962878676175*^9, 3.499628803808625*^9}},
 CellID->102339826],

Cell[TextData[{
 "It is shown in the Details section that a contour plot of the vector \
potential ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "\[Phi]"], "(", 
    RowBox[{"x", ",", "z"}], ")"}], TraditionalForm]], "InlineMath"],
 " in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]], "InlineMath"],
 " plane coincides with the ",
 "magnetic",
 " lines of force."
}], "ManipulateCaption",
 CellChangeTimes->{
  3.35696210375764*^9, {3.473285070778674*^9, 3.473285151495852*^9}, {
   3.47328518924331*^9, 3.4732852381231117`*^9}, {3.473285279042029*^9, 
   3.473285282879472*^9}, {3.499438933872566*^9, 3.499438933872795*^9}, {
   3.4994389663224*^9, 3.499438966322667*^9}},
 CellID->668102822]
}, Open  ]],

