      "Options" :> {TrackedSymbols :> {$CellContext`a$$, $CellContext`i$$}}, 
      "DefaultOptions" :> {ControllerLinking -> True}],
     ImageSizeCache->{618., {256.34375, 261.65625}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>({$CellContext`loop1[
         Pattern[$CellContext`a, 
          Blank[]], 
         Pattern[$CellContext`i, 
          Blank[]]] := Graphics[{
          Thickness[0.015], Black, 
          
          Circle[{0, 0}, {$CellContext`a, 0.1 $CellContext`a}, {
           0.1, Pi - 0.1}], 
          Thickness[0.01], Yellow, 
          
          Circle[{0, 
           0}, {$CellContext`a, 0.1 $CellContext`a}, {-0.3, Pi + 
            0.3}]}], $CellContext`g[
         Pattern[$CellContext`a, 
          Blank[]], 
         Pattern[$CellContext`i, 
          Blank[]]] := ContourPlot[
         $CellContext`AA[$CellContext`a, $CellContext`i, $CellContext`x, \
$CellContext`z], {$CellContext`x, -12, 12}, {$CellContext`z, -10, 10}, 
         Contours -> Max[5, 
           Floor[2 $CellContext`i]], ContourStyle -> Directive[{
            Thickness[0.005], 
            RGBColor[0.25, 0.43, 0.82]}], ContourShading -> None, Axes -> 
         False, Frame -> False], $CellContext`AA[
         Pattern[$CellContext`a, 
          Blank[]], 
         Pattern[$CellContext`i, 
          Blank[]], 
         Pattern[$CellContext`x, 
          Blank[]], 
         Pattern[$CellContext`z, 
          Blank[]]] := (((($CellContext`i Pi) $CellContext`a^2) 
          Abs[$CellContext`x])/($CellContext`a^2 + $CellContext`x^2 + \
$CellContext`z^2)^(3/2)) (
         1 + ((15 $CellContext`a^2) $CellContext`x^2)/(
          8 ($CellContext`a^2 + $CellContext`x^2 + $CellContext`z^2)^2)), \
$CellContext`loop2[
         Pattern[$CellContext`a, 
          Blank[]], 
