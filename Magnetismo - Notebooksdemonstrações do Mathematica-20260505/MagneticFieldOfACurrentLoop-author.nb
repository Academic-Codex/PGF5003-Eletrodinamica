 StyleBox["Classical Electrodynamics, ",
  FontSlant->"Italic"],
 "3rd ed.",
 ", New York: John Wiley & Sons, 1999 pp. 181\[Dash]186."
}], "DetailNotes",
 CellChangeTimes->{
